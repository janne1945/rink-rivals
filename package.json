{
  "name": "rink-rivals",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:production": "pnpm build && E2E_PRODUCTION=1 playwright test",
    "catalog:validate": "tsx scripts/validate-catalog.ts",
    "catalog:sql": "tsx scripts/generate-supabase-catalog.ts",
    "catalog:sql:write": "tsx scripts/generate-supabase-catalog.ts --write",
    "catalog:sql:check": "tsx scripts/generate-supabase-catalog.ts --check",
    "catalog:import": "tsx scripts/import-stats.ts",
    "balance": "tsx scripts/balance-diagnostics.ts",
    "supabase:start": "supabase start",
    "supabase:test": "supabase test db",
    "supabase:types": "supabase gen types typescript --local > src/infrastructure/supabase/database.types.ts",
    "qa:core": "pnpm typecheck && pnpm test && pnpm catalog:validate && pnpm catalog:sql:check && pnpm balance && pnpm build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "dexie": "^4.0.11",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "supabase": "^2.109.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.7.0"
}
